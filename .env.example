# Projeto Supabase que guarda os cadastros de contratação.
# Estas duas são públicas por natureza: vão no bundle entregue ao navegador.
# Quem protege os dados é o RLS — o papel anon não tem privilégio em tabela
# nenhuma, só executa duas funções que nunca devolvem dado de cliente.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
