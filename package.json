{
  "name": "portalinternet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hostgator": "tsc -b && vite build --base=/projetos/PortalInternet/",
